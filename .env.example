# Copy to .env and fill in. See README.md.
#
# This file is the BASELINE only. Model, voice, TTS backend and caller
# permissions are all editable at runtime from the settings panel on the call
# page. Precedence: settings panel > this file > built-in defaults.

# --- SUB/WAVE station ---
# Point these at your SUB/WAVE controller. Everything else (personas, cards,
# voices, tools) is discovered from it. MCP may be left blank — it derives as
# {SUBWAVE_BASE_URL}/mcp.
SUBWAVE_BASE_URL=http://localhost:7700/api
SUBWAVE_MCP_URL=
# Needed to mirror the station's own DJ/TTS config (GET /api/settings returns
# 401 without these) rather than keeping a second copy locally.
SUBWAVE_ADMIN_USER=
SUBWAVE_ADMIN_PASS=

# --- LiveKit (self-hosted; key/secret must match livekit.yaml) ---
# Docker only: the host's LAN IP, advertised to browsers as the media
# address. Without it a containerized LiveKit advertises its container IP
# and calls hang at "Ringing". Ignored by run-local.ps1.
LIVEKIT_NODE_IP=127.0.0.1
# Generate a fresh pair before exposing beyond localhost:
#   python -c "import secrets; print(secrets.token_urlsafe(36))"
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=
LIVEKIT_URL=ws://localhost:7880
# What the BROWSER connects to — differs from LIVEKIT_URL behind a proxy.
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# --- STT --- provider: deepgram | openai | google | local
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
# STT model for whichever provider is chosen (e.g. nova-3, base.en).
# DEEPGRAM_MODEL is still read as a fallback for older .env files.
STT_MODEL=nova-3

# --- LLM --- provider: openai | ollama | google | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- TTS ---
TTS_MODE=cloud
TTS_BASE_URL=https://api.openai.com
TTS_API_KEY=
TTS_ADAPTER_CONFIG=

# --- Widget / token server ---
TOKEN_SERVER_PORT=8100
# Where the WORKER reaches the token server to release call slots on hangup.
# Only needed when they don't share a host (e.g. docker compose).
CALLIN_INTERNAL_URL=
# How often to ping the station so its lazy caches stay hot (seconds).
STATION_WARM_INTERVAL=45
# Where the station should POST webhook events; blank = auto-derived from the
# machine's LAN address.
CALLIN_HOOK_URL=
# Comma-separated origins allowed to embed / mint tokens. "*" is dev-only.
CALLIN_ALLOWED_ORIGINS=*
# Set to require X-Admin-Key on settings writes. Blank = open (local dev).
CALLIN_ADMIN_KEY=

LOG_LEVEL=INFO
# Both processes also write rotating log files to data/logs/ (worker.log,
# token-server.log, livekit.log). LOG_DIR moves them; LOG_TO_FILE=0 disables
# file logging (e.g. under docker, where stdout is already captured).
LOG_DIR=
LOG_TO_FILE=1
