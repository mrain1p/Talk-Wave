# Copy to .env and fill in. See README.md.
# This file is the BASELINE only — model, voice, TTS backend and caller permissions are all
# editable at runtime in the settings panel. Precedence: panel > this file > built-in defaults.

# --- SUB/WAVE station -------------------------------------------------------
# Everything (personas, cards, voices, tools) is discovered from the controller.
SUBWAVE_BASE_URL=http://localhost:7700/api
SUBWAVE_MCP_URL=            # blank derives {SUBWAVE_BASE_URL}/mcp
# Where the CALLER'S BROWSER pulls the broadcast. Blank derives the station's plain-http LAN
# address — right for plain-http LAN setups, silently blocked as mixed content behind TLS (the
# call then runs with no music). Set the station's PUBLIC https stream; a bare origin also works.
SUBWAVE_STREAM_URL=
# The station's own login — used to mirror its DJ/TTS config instead of keeping a second copy.
SUBWAVE_ADMIN_USER=
SUBWAVE_ADMIN_PASS=

# --- LiveKit (self-hosted; key/secret must match livekit.yaml) --------------
# THE one docker deployment variable: this machine's LAN IP. Drives LiveKit's advertised media
# address, the browser URL, and the webhook callback. Without it calls hang at "Ringing".
HOST_IP=
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=         # fresh pair: python -c "import secrets; print(secrets.token_urlsafe(36))"
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880    # what the BROWSER connects to — differs behind a proxy

# --- STT --- provider: deepgram | openai | google | local
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
STT_MODEL=nova-3            # model for the chosen provider (e.g. nova-3, base.en);
                            # DEEPGRAM_MODEL still read as a fallback for older .env files

# --- LLM --- provider: openai | ollama | google | anthropic | openrouter
#             | deepseek | requesty | gateway | openai-compatible | locca
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=               # openai-compatible (llama.cpp/vLLM/LM Studio): REQUIRED, your server's
                            # address. locca: blank falls back to its usual host address
                            # (LOCCA_BASE_URL overrides).
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
REQUESTY_API_KEY=
AI_GATEWAY_API_KEY=
# OPENAI_COMPAT_API_KEY=    # only if your openai-compatible server checks keys — most don't
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- TTS ---------------------------------------------------------------------
TTS_MODE=cloud
TTS_BASE_URL=https://api.openai.com
TTS_API_KEY=                # optional; usually for a self-hosted speech server's own token
ELEVENLABS_API_KEY=         # elevenlabs-cloud adapter (sent as xi-api-key)
FISH_API_KEY=               # fish-audio-cloud adapter
TTS_ADAPTER_CONFIG=

# --- Widget / token server ---------------------------------------------------
TOKEN_SERVER_PORT=8100
CALLIN_INTERNAL_URL=        # where the WORKER reaches the token server; only needed when they
                            # don't share a host (docker compose sets it)
STATION_WARM_INTERVAL=45    # seconds between station pings that keep its lazy caches hot
CALLIN_HOOK_URL=            # where the station POSTs webhooks; blank auto-derives from the LAN IP
# Origins allowed to EMBED the widget and mint call tokens, comma-separated. EMPTY is safe and
# right for most deployments (the widget's own page is same-origin); add entries only to embed on
# another site. "*" is dev-only — it lets any page on the internet spend your API budget.
# Also a panel setting since 0.10.63 (The call card -> Embed on another page), which wins over
# this line and applies without a restart; this is the baseline under it.
CALLIN_ALLOWED_ORIGINS=
# CALLIN_ALLOWED_ORIGINS=https://radio.example.com,https://www.example.com
# Origins allowed to reach the SETTINGS PANEL while no password is set — separate on purpose
# (embedding costs budget; the panel costs the controls). Blank is right for almost everyone: a
# literal address (LAN IP, localhost) already works. Name an origin only if you reach the panel
# by HOSTNAME before setting a password. Irrelevant once a password exists.
CALLIN_PANEL_ORIGINS=
# Whose X-Forwarded-For to believe: addresses/CIDRs of YOUR reverse proxies. Blank trusts any
# loopback or private peer (covers a proxy on the docker bridge), read one hop deep. Set it
# explicitly only if this port is also reachable directly from an untrusted network.
CALLIN_TRUSTED_PROXIES=
# Break-glass panel password — ALWAYS accepted, on top of the panel-set one. Recovery for a lost
# password or IP lockout. Blank = panel is open until a password is set in the GUI.
CALLIN_ADMIN_KEY=

LOG_LEVEL=INFO
LOG_DIR=                    # moves the rotating file logs (default data/logs/)
LOG_TO_FILE=1               # 0 under docker — stdout is already captured
