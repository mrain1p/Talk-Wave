# Copy to .env and fill in. See README.md.
#
# This file is the BASELINE only. Model, voice, TTS backend and caller
# permissions are all editable at runtime from the settings panel on the call
# page. Precedence: settings panel > this file > built-in defaults.

# --- SUB/WAVE station ---
# Point these at your SUB/WAVE controller. Everything else (personas, cards,
# voices, tools) is discovered from it. MCP may be left blank — it derives as
# {SUBWAVE_BASE_URL}/mcp.
SUBWAVE_BASE_URL=http://localhost:7700/api
SUBWAVE_MCP_URL=
# Where the CALLER'S BROWSER pulls the broadcast from while on the line.
# Leave blank and it derives from SUBWAVE_BASE_URL, which is right only when
# the caller is on the same LAN and the widget is served over plain http:
# behind TLS a browser silently refuses to load an http stream into an https
# page, and the call runs with no station behind it. Set this to the station's
# public https stream. A bare origin works too — the mounts SubWave publishes
# at /listen.pls (mp3 first, then any optional ones such as opus) are found
# automatically. The panel's pipeline check tests it.
SUBWAVE_STREAM_URL=
# Needed to mirror the station's own DJ/TTS config (GET /api/settings returns
# 401 without these) rather than keeping a second copy locally.
SUBWAVE_ADMIN_USER=
SUBWAVE_ADMIN_PASS=

# --- LiveKit (self-hosted; key/secret must match livekit.yaml) ---
# Docker only — THE one deployment variable: the LAN IP of the machine
# running the stack. Drives LiveKit's advertised media address, the URL
# browsers connect to, and the station webhook callback. Without it a
# containerized LiveKit advertises its container IP and calls hang at
# "Ringing". Ignored by run-local.ps1.
HOST_IP=
# Generate a fresh pair before exposing beyond localhost:
#   python -c "import secrets; print(secrets.token_urlsafe(36))"
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=
LIVEKIT_URL=ws://localhost:7880
# What the BROWSER connects to — differs from LIVEKIT_URL behind a proxy.
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# --- STT --- provider: deepgram | openai | google | local
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
# STT model for whichever provider is chosen (e.g. nova-3, base.en).
# DEEPGRAM_MODEL is still read as a fallback for older .env files.
STT_MODEL=nova-3

# --- LLM --- provider: openai | ollama | google | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- TTS ---
TTS_MODE=cloud
TTS_BASE_URL=https://api.openai.com
TTS_API_KEY=
TTS_ADAPTER_CONFIG=

# --- Widget / token server ---
TOKEN_SERVER_PORT=8100
# Where the WORKER reaches the token server to release call slots on hangup.
# Only needed when they don't share a host (e.g. docker compose).
CALLIN_INTERNAL_URL=
# How often to ping the station so its lazy caches stay hot (seconds).
STATION_WARM_INTERVAL=45
# Where the station should POST webhook events; blank = auto-derived from the
# machine's LAN address.
CALLIN_HOOK_URL=
# Comma-separated origins allowed to embed the widget and mint call tokens.
# Set this to your real origin(s) before anyone else can reach the page.
#
# "*" is dev-only and means any page on the internet can mint a token against
# this service — someone else's site can put your Call button on their page and
# spend your API budget. It used to be the shipped value here; it is now
# commented out, so a fresh deploy has to say what it wants. Both processes log
# a warning at startup while it is "*".
#
# Leaving it EMPTY is safe and is what most deployments want: the widget on
# this service's own page is same-origin and needs no entry here. You only need
# a value to embed the widget on another site.
CALLIN_ALLOWED_ORIGINS=
# CALLIN_ALLOWED_ORIGINS=https://radio.example.com,https://www.example.com
# Origins allowed to reach the SETTINGS PANEL while no password is set.
# Deliberately separate from the list above: letting a page embed a Call button
# costs you API budget, letting it open the panel costs you the controls — the
# settings, which keys are set, and the choice of admin password. They are not
# the same permission and they do not share a list.
# Blank (the default) is right for almost everyone: the first-run panel already
# accepts a literal address, so a LAN IP or localhost works with nothing set
# here. Name an origin only if you reach the panel by HOSTNAME and have not set
# a password yet — a name can be pointed at this box by someone else, which is
# why it is not trusted on sight. Setting a password makes this irrelevant.
CALLIN_PANEL_ORIGINS=
# Whose X-Forwarded-For to believe: comma-separated addresses or CIDRs of the
# reverse proxies in front of this service. That header decides a caller's
# cooldown and which address a failed password locks out, so it is only read
# when the connection came FROM one of these — otherwise anyone could pick
# their own identity, or someone else's.
# Blank (the default) trusts any loopback or private-range peer, which covers
# the normal deployment: a reverse proxy reaching the container over the docker
# bridge. Set it explicitly when this port is reachable directly from an
# untrusted network as well as through the proxy.
# One hop only: the entry read is the one your proxy appended. Behind a CDN as
# well (two hops), that entry is the CDN's address rather than the caller's, so
# every caller shares one rate-limit bucket — restrictive, not permissive, but
# worth knowing.
CALLIN_TRUSTED_PROXIES=
# Break-glass panel password. The normal password is set in the settings
# panel (Security section, stored hashed); this env value is ALWAYS also
# accepted — use it to recover from a lost password or an IP lockout.
# Blank = panel is open until a password is set in the GUI.
CALLIN_ADMIN_KEY=

LOG_LEVEL=INFO
# Both processes also write rotating log files to data/logs/ (worker.log,
# token-server.log, livekit.log). LOG_DIR moves them; LOG_TO_FILE=0 disables
# file logging (e.g. under docker, where stdout is already captured).
LOG_DIR=
LOG_TO_FILE=1
